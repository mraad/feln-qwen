# Copy to .env without overwriting an existing file, edit, then export in your shell.
# The application does not automatically load this file. See docs/CONFIGURATION.md.

# Mac: absolute local paths; originals stay read-only.
FELN_APP_REPO=/path/to/feln-lora
NORTHSEA_SOURCE=/path/to/NorthSea

# RTX: existing, verified environments; do not install into the training environment.
TRAIN_VENV=/path/to/training/.venv
LLAMA_CPP_DIR=/path/to/llama.cpp

# Install time only: credential-free VCS URL, including the git+ prefix.
# Set the actual repository locally; requirements retain the validated revision.
LAYERS_JSON_REPOSITORY=git+https://example.invalid/organization/layers-json.git

# Existing application runtime settings on Orin.
FELN_ROOT=/data/feln-qwen-20260917
FELN_MODEL_URL=http://127.0.0.1:18092
